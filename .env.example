# ---------------------------------------------
# LinkMind AI — Environment Configuration
# ---------------------------------------------

# Application
PROJECT_NAME="LinkMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# Database (default is SQLite; uncomment below for PostgreSQL)
DATABASE_URL="sqlite:///./linkmind.db"
# DATABASE_URL="postgresql://linkmind:linkmindpass@localhost:5432/linkmind_db"

# AI Provider Configuration (Optional: system runs with built-in heuristic parser if omitted)
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# File Uploads & Security
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE=15728640
REQUEST_TIMEOUT_SECONDS=15
